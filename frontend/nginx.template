# Processado pelo envsubst da imagem nginx; somente os tokens FO e BO explicitamente permitidos são substituídos.
# RF02c (ADR-010): escrita só de origem local; GET passa, POST exige Origin de localhost/127.0.0.1.
map "$request_method|$http_origin" $ordens_origem_recusada {
  default 1;
  "~^GET\|" 0;
  "~^POST\|https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$" 0;
}
# Rate limit só para POST: chave vazia (GET) não é contabilizada, então listagens não esgotam envios.
map $request_method $ordens_limite { POST $binary_remote_addr; default ""; }
limit_req_zone $ordens_limite zone=ordens:1m rate=10r/s;
# Resumo e livro compartilham a cota por IP; inclui outras abas da mesma origem local.
limit_req_zone $binary_remote_addr zone=mercado:1m rate=5r/s;
  server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    # DNS rebinding: só nomes locais; um domínio externo apontado para 127.0.0.1 é recusado.
    if ($host !~* "^(localhost|127\.0\.0\.1)$") { return 421; }
    location = /healthz { access_log off; default_type text/plain; return 200 'ok'; }
    # RF01: somente leitura recebe o token do proxy; preparação sintética nunca passa pelo navegador.
    location ^~ /servicos/front-office/api/v1/preparacoes-mercado {
      default_type application/json;
      return 403 '{"erro":"Preparação indisponível pelo navegador"}';
    }
    location ^~ /servicos/front-office/api/v1/ativos {
      limit_except GET { deny all; }
      limit_req zone=mercado burst=10 nodelay;
      limit_req_status 429;
      # Inclui recusas locais, que não passam pelos filtros do FO.
      proxy_hide_header Cache-Control;
      add_header Cache-Control no-store always;
      # add_header no location substitui a herança do server no Nginx 1.28.
      add_header X-Content-Type-Options nosniff always;
      add_header Referrer-Policy same-origin always;
      set $backend front-office:8080;
      rewrite ^/servicos/front-office/(.*)$ /$1 break;
      proxy_pass http://$backend;
      proxy_set_header Host $host;
      proxy_set_header X-Request-ID $request_id;
      proxy_set_header Authorization "Bearer ${FO_TOKEN_LEITURA}";
    }
    # Regex exata: o token de escrita só alcança as rotas revisadas de ordens, nunca prefixos futuros.
    location ~ "^/servicos/front-office/api/v1/ordens(-oco)?(/[0-9a-f-]{36})?$" {
      limit_except GET POST { deny all; }
      if ($ordens_origem_recusada) { return 403 '{"erro":"Origem não permitida para ordens"}'; }
      limit_req zone=ordens burst=20 nodelay;
      limit_req_status 429;
      default_type application/json;
      set $backend front-office:8080;
      rewrite ^/servicos/front-office/(.*)$ /$1 break;
      proxy_pass http://$backend;
      proxy_set_header Host $host;
      proxy_set_header X-Request-ID $request_id;
      proxy_set_header Authorization "Bearer ${FO_TOKEN_ORDENS}";
    }
    location /servicos/front-office/ {
      set $backend front-office:8080;
      rewrite ^/servicos/front-office/(.*)$ /$1 break;
      proxy_pass http://$backend;
      proxy_set_header Host $host;
      proxy_set_header X-Request-ID $request_id;
      proxy_set_header Authorization "";
    }
    # RF04b: preparação de carteiras nunca passa pelo navegador; o proxy não repassa token do cliente ao MO.
    location /servicos/middle-office/ {
      if ($uri ~* "preparacoes-risco") {
        return 403 '{"erro":"Preparação indisponível pelo navegador"}';
      }
      default_type application/json;
      proxy_set_header Authorization "";
      set $backend middle-office:8080;
      rewrite ^/servicos/middle-office/(.*)$ /$1 break;
      proxy_pass http://$backend;
      proxy_set_header Host $host;
      proxy_set_header X-Request-ID $request_id;
    }
    location /servicos/matching-engine/ {
      set $backend matching-engine:8080;
      rewrite ^/servicos/matching-engine/(.*)$ /$1 break;
      proxy_pass http://$backend;
      proxy_set_header Host $host;
      proxy_set_header X-Request-ID $request_id;
    }
    location = /servicos/back-office/api/v1/posicoes {
      limit_except GET { deny all; }
      proxy_hide_header Cache-Control;
      add_header Cache-Control no-store always;
      add_header X-Content-Type-Options nosniff always;
      add_header Referrer-Policy same-origin always;
      set $backend back-office:8080;
      rewrite ^/servicos/back-office/(.*)$ /$1 break;
      proxy_pass http://$backend;
      proxy_set_header Host $host;
      proxy_set_header X-Request-ID $request_id;
      proxy_set_header Authorization "Bearer ${BO_TOKEN_POSICOES}";
    }
    location /servicos/back-office/ {
      proxy_set_header Authorization "";
      set $backend back-office:8080;
      rewrite ^/servicos/back-office/(.*)$ /$1 break;
      proxy_pass http://$backend;
      proxy_set_header Host $host;
      proxy_set_header X-Request-ID $request_id;
    }
    location /servicos/ { default_type application/json; return 404 '{"erro":"Serviço desconhecido"}'; }
    location / { try_files $uri $uri/ /index.html; }
  }
