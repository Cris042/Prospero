    {
      "id": 6,
      "title": "Latência HTTP aproximada p50/p95/p99",
      "type": "timeseries",
      "description": "Histograma cumulativo aproximado, independente dos quantis nearest rank exatos por execução. Ver população no relatório.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (servico, le) (rate(carga_duracao_seconds_bucket[30s])))",
          "legendFormat": "p50 {{servico}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (servico, le) (rate(carga_duracao_seconds_bucket[30s])))",
          "legendFormat": "p95 {{servico}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (servico, le) (rate(carga_duracao_seconds_bucket[30s])))",
          "legendFormat": "p99 {{servico}}"
