    {
      "title": "Acerto do cache Redis de cotação (5min)",
      "type": "timeseries",
      "description": "Fonte: ConsultarCotacaoActor (ADR-022). Fração das leituras de ativos/livro servidas pelo Redis; o restante caiu para o PostgreSQL por ausência da chave ou Redis indisponível. Sem leituras na janela, sem dados.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(prospero_cotacao_leituras_total{job=\"prospero\",servico=\"front-office\",origem=\"REDIS\"}[5m])) / sum(rate(prospero_cotacao_leituras_total{job=\"prospero\",servico=\"front-office\"}[5m]))",
          "legendFormat": "acerto"
        }
      ],
      "fieldConfig": {
        "defaults": {
