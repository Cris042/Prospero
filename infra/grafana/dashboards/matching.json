    },
    {
      "title": "p99 do núcleo/serialização (5min)",
      "type": "timeseries",
      "description": "Fonte: ProcessadorMatching. Sem I/O, aproximação por buckets; meta de 1 ms e população do HLD-004.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le,servico) (rate(prospero_matching_comando_seconds_bucket{job=\"prospero\",servico=\"matching-engine\"}[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Comandos observados no timer ME (5min)",
      "type": "timeseries",
      "description": "Denominador do histograma; sem amostras o percentil não é válido.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
