    {
      "title": "Leituras que caíram para o PostgreSQL e falhas do Redis (5min)",
      "type": "timeseries",
      "description": "Fonte: ConsultarCotacaoActor e CacheCotacaoRedis (ADR-022). Fallback não é erro: a resposta continua, com X-Origem-Dados=POSTGRES. Falha abre pausa de 5 s sem tentar o Redis.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(prospero_cotacao_leituras_total{job=\"prospero\",servico=\"front-office\",origem=\"POSTGRES\"}[5m]))",
          "legendFormat": "leituras do PostgreSQL"
        },
        {
          "refId": "B",
          "expr": "sum by (operacao) (increase(prospero_cotacao_redis_falhas_total{job=\"prospero\",servico=\"front-office\"}[5m]))",
