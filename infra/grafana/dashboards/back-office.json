    {
      "title": "Pendências observadas na outbox BO",
      "type": "timeseries",
      "description": "Fonte: RelayOutbox BO. Confirmação D0 e crédito D2 usam a outbox; gauge não distingue volumes financeiros nem garante frescor.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "prospero_outbox_pendentes{job=\"prospero\",servico=\"back-office\"}",
          "legendFormat": "pendências"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
